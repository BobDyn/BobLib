within BobLib.Controllers;

package Internal

  extends Modelica.Icons.InternalPackage;
  annotation(
    Documentation(info = "<html>
<p>
Package <code>BobLib.Controllers.Internal</code> contains BobLib controller implementation details.
</p>
<p>
Public controller models remain VehicleInterfaces-facing adapters; this package holds the reusable logic behind those adapters.
</p>
</html>"));
  annotation(Icon(graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, lineThickness = 0.5, fillPattern = FillPattern.None)}));
end Internal;
