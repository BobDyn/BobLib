within BobLib.Controllers;
model VCU

  "BobLib VCU exposed inside the VehicleInterfaces controller domain"

  import Modelica.Units.SI;

  parameter BobLib.Records.VehicleRecord.Controllers.VCURecord pVCU(
    tau_max = 240,
    regenTorqueLimit = 0) "Torque limits, reduction and brake blending calibration" annotation(Dialog(group = "Calibration"));

  extends BobLib.Controllers.Interfaces.Base;

  // Electric-drive torque mapping

  parameter Boolean enableRegenerativeBraking = false "Blend regeneration into driver brake demand" annotation(Dialog(group = "Operating settings"), choices(checkBox = true));
  parameter Boolean enableMechanicalBraking = true "Apply friction brakes after regenerative blending" annotation(Dialog(group = "Operating settings"), choices(checkBox = true));

  // Published controller diagnostics
  output SI.Power P_req
    "Power request published to electricMotorControlBus [W]";
  output SI.Torque tau_cmd_limited
    "Final torque command after limits [Nm]";
  output Boolean vcu_active
    "VCU active / inverter enabled";
  output SI.Torque driveTorqueCmd
    "Rear-axle electric drive torque command requested by the driver [Nm]";
  output Real acceleratorPedalCmd(unit = "1")
    "Equivalent positive-torque pedal diagnostic; not published to driverBus";
  output Real brakePedalCmd(unit = "1")
    "Equivalent mechanical-brake pedal diagnostic; not published to driverBus";
  output SI.Torque mechanicalBrakeTorqueCmd
    "Combined mechanical brake torque request generated by VCU";
  output SI.Torque regenBrakeTorqueCmd
    "Rear-axle regenerative brake torque magnitude generated by VCU";
  output SI.Torque regenLimitCmd
    "Regenerative torque limit generated by VCU [Nm]";

protected
  SI.Torque rearAxleTorqueCapacity;
  SI.Torque rearAxleRegenTorqueCapacity;
  SI.Torque driverDriveTorqueDemand;
  SI.Torque driverMechanicalBrakeTorqueDemand;
  Real cmd_accelerator_pedal(unit = "1");
  Real cmd_brake_pedal(unit = "1");
  Boolean cmd_inverter_enable;
  SI.AngularVelocity sens_motor_speed;

  Modelica.Blocks.Interfaces.RealInput acceleratorPedalBusTap(unit = "1")
    "Driver accelerator-pedal command from driverBus" annotation(
      Placement(
        transformation(origin = {-180, 135}, extent = {{-5, -5}, {5, 5}}, rotation = 0),
        iconTransformation(origin = {-98, 76}, extent = {{-6, -6}, {6, 6}})));

  Modelica.Blocks.Interfaces.RealInput brakePedalBusTap(unit = "1")
    "Driver brake-pedal command from driverBus" annotation(
      Placement(
        transformation(origin = {-180, 105}, extent = {{-5, -5}, {5, 5}}, rotation = 0),
        iconTransformation(origin = {-96, 72}, extent = {{-6, -6}, {6, 6}})));
  Modelica.Blocks.Interfaces.BooleanInput inverterEnableBusTap
    "Inverter enable / R2D command from driverBus" annotation(
      Placement(
        transformation(origin = {-180, 42.5}, extent = {{-5, -5}, {5, 5}}, rotation = 0),
        iconTransformation(origin = {-94, 68}, extent = {{-6, -6}, {6, 6}})));

  Modelica.Blocks.Interfaces.RealInput motorSpeedBusTap(
    quantity = "AngularVelocity",
    unit = "rad/s")
    "Motor speed from electricMotorBus" annotation(
      Placement(
        transformation(origin = {-180, 20}, extent = {{-5, -5}, {5, 5}}, rotation = 0),
        iconTransformation(origin = {-100, 2}, extent = {{-6, -6}, {6, 6}})));

  Modelica.Blocks.Sources.RealExpression powerRequestBusSignal(
    y = P_req) "Power request published to electricMotorControlBus" annotation(
      Placement(transformation(origin = {140, 165}, extent = {{15, -15}, {-15, 15}}, rotation = 0)));

  Modelica.Blocks.Sources.RealExpression limitedTorqueBusSignal(
    y = tau_cmd_limited) "Limited motor torque command published to electricMotorControlBus" annotation(
      Placement(transformation(origin = {140, 130}, extent = {{15, -15}, {-15, 15}}, rotation = 0)));

  Modelica.Blocks.Sources.BooleanExpression vcuActiveBusSignal(
    y = vcu_active) "VCU active state published to electricMotorControlBus" annotation(
      Placement(transformation(origin = {140, 95}, extent = {{15, -15}, {-15, 15}}, rotation = 0)));

  Modelica.Blocks.Sources.RealExpression driveTorqueCommandBusSignal(
    y = driveTorqueCmd) "Rear-axle drive torque command published to drivelineControlBus" annotation(
      Placement(transformation(origin = {230, 25}, extent = {{-15, -15}, {15, 15}}, rotation = 0)));

  Modelica.Blocks.Sources.RealExpression regenLimitBusSignal(
    y = regenLimitCmd) "Regenerative torque limit published to electricMotorControlBus" annotation(
      Placement(transformation(origin = {140, 60}, extent = {{15, -15}, {-15, 15}}, rotation = 0)));

  Modelica.Blocks.Sources.RealExpression mechanicalBrakeTorqueBusSignal(
    y = mechanicalBrakeTorqueCmd) "Mechanical brake torque request published to brakesControlBus" annotation(
      Placement(transformation(origin = {310, -10}, extent = {{-15, -15}, {15, 15}}, rotation = 0)));

  Modelica.Blocks.Sources.RealExpression motorTorqueRequest(
    y = driveTorqueCmd / max(pVCU.finalDriveRatio, 1e-6)) annotation(
      Placement(transformation(origin = {20, 130}, extent = {{-22.5, -22.5}, {22.5, 22.5}}, rotation = 0)));

  Modelica.Blocks.Sources.RealExpression regenLimitRequest(
    y = regenLimitCmd) annotation(
      Placement(transformation(origin = {-95, 31.25}, extent = {{-15, -15}, {15, 15}}, rotation = 0)));

  BobLib.Controllers.Internal.VCUCore vcu(pVCU = pVCU) annotation(
      Placement(transformation(origin = {0, 20}, extent = {{-60, -30}, {60, 30}}, rotation = 0)));

  BobLib.DriverEnvironments.Interfaces.DriverBus driverBus
    "Typed driverBus signal contract" annotation(
      Placement(transformation(origin = {-240, -40}, extent = {{-20, -20}, {20, 20}})));
  BobLib.ElectricDrives.Interfaces.ElectricMotorBus electricMotorBus
    "Typed electricMotorBus signal contract" annotation(
      Placement(transformation(origin = {-190, -40}, extent = {{-20, -20}, {20, 20}})));
  BobLib.ElectricDrives.Interfaces.ElectricMotorControlBus electricMotorControlBus
    "Typed electricMotorControlBus signal contract" annotation(
      Placement(transformation(origin = {100, -40}, extent = {{-25, -25}, {25, 25}})));
  BobLib.Drivelines.Interfaces.DrivelineControlBus drivelineControlBus
    "Typed drivelineControlBus signal contract" annotation(
      Placement(transformation(origin = {270, -40}, extent = {{-20, -20}, {20, 20}})));
  BobLib.Brakes.Interfaces.BrakesControlBus brakesControlBus
    "Typed brakesControlBus signal contract" annotation(
      Placement(transformation(origin = {350, -40}, extent = {{-20, -20}, {20, 20}})));

equation
  connect(driverBus, controlBus.driverBus) annotation(
    Line(points = {{-240, -40}, {-240, -75}, {0, -75}, {0, -100}}, color = {255, 204, 51}, thickness = 0.5));
  connect(electricMotorBus, controlBus.electricMotorBus) annotation(
    Line(points = {{-190, -40}, {-190, -75}, {0, -75}, {0, -100}}, color = {255, 204, 51}, thickness = 0.5));
  connect(electricMotorControlBus, controlBus.electricMotorControlBus) annotation(
    Line(points = {{100, -40}, {100, -75}, {0, -75}, {0, -100}}, color = {255, 204, 51}, thickness = 0.5));
  connect(drivelineControlBus, controlBus.drivelineControlBus) annotation(
    Line(points = {{270, -40}, {270, -75}, {0, -75}, {0, -100}}, color = {255, 204, 51}, thickness = 0.5));
  connect(brakesControlBus, controlBus.brakesControlBus) annotation(
    Line(points = {{350, -40}, {350, -75}, {0, -75}, {0, -100}}, color = {255, 204, 51}, thickness = 0.5));
  rearAxleTorqueCapacity =
    pVCU.tau_max * max(pVCU.finalDriveRatio, 1e-6);

  rearAxleRegenTorqueCapacity =
    pVCU.regenTorqueLimit * max(pVCU.finalDriveRatio, 1e-6);

  cmd_accelerator_pedal = acceleratorPedalBusTap;
  cmd_brake_pedal = brakePedalBusTap;
  cmd_inverter_enable = inverterEnableBusTap;
  sens_motor_speed = motorSpeedBusTap;

  driverDriveTorqueDemand = noEvent(min(1, max(0, cmd_accelerator_pedal)))*rearAxleTorqueCapacity;
  driverMechanicalBrakeTorqueDemand = noEvent(min(1, max(0, cmd_brake_pedal)))*pVCU.mechanicalBrakeTorqueLimit;
  regenBrakeTorqueCmd = if enableRegenerativeBraking and cmd_inverter_enable then
    noEvent(min(rearAxleRegenTorqueCapacity, pVCU.regenBrakeBlend*driverMechanicalBrakeTorqueDemand)) else 0;
  mechanicalBrakeTorqueCmd = if enableMechanicalBraking then
    noEvent(min(pVCU.mechanicalBrakeTorqueLimit, max(0, driverMechanicalBrakeTorqueDemand-regenBrakeTorqueCmd))) else 0;
  driveTorqueCmd = driverDriveTorqueDemand-regenBrakeTorqueCmd;
  acceleratorPedalCmd = noEvent(min(1, max(0, cmd_accelerator_pedal)));
  brakePedalCmd = noEvent(min(1, max(0, mechanicalBrakeTorqueCmd/max(pVCU.mechanicalBrakeTorqueLimit, 1e-6))));
  regenLimitCmd = if enableRegenerativeBraking and cmd_inverter_enable then pVCU.regenTorqueLimit else 0;

  P_req = vcu.P_req;
  tau_cmd_limited = vcu.tau_cmd_limited;
  vcu_active = vcu.vcu_active;

  connect(driverBus.acceleratorPedalPosition, acceleratorPedalBusTap) annotation(
    Line(points = {{-240, -40}, {-240, 135}, {-180, 135}}, color = {0, 0, 127}));
  connect(driverBus.brakePedalPosition, brakePedalBusTap) annotation(
    Line(points = {{-240, -40}, {-240, 105}, {-180, 105}}, color = {0, 0, 127}));
  connect(driverBus.inverterEnable, inverterEnableBusTap) annotation(
    Line(points = {{-240, -40}, {-240, 42.5}, {-180, 42.5}}, color = {255, 0, 255}));
  connect(electricMotorBus.speed, motorSpeedBusTap) annotation(
    Line(points = {{-190, -40}, {-190, 20}, {-180, 20}}, color = {0, 0, 127}));

  connect(powerRequestBusSignal.y, electricMotorControlBus.powerRequest) annotation(
    Line(points = {{123.5, 165}, {100, 165}, {100, -40}}, color = {0, 0, 127}));
  connect(limitedTorqueBusSignal.y, electricMotorControlBus.limitedTorqueCommand) annotation(
    Line(points = {{123.5, 130}, {100, 130}, {100, -40}}, color = {0, 0, 127}));
  connect(vcuActiveBusSignal.y, electricMotorControlBus.vcuActive) annotation(
    Line(points = {{123.5, 95}, {100, 95}, {100, -40}}, color = {255, 0, 255}));
  connect(driveTorqueCommandBusSignal.y, drivelineControlBus.driveTorqueCommand) annotation(
    Line(points = {{246.5, 25}, {270, 25}, {270, -40}}, color = {0, 0, 127}));
  connect(regenLimitBusSignal.y, electricMotorControlBus.regenTorqueLimit) annotation(
    Line(points = {{123.5, 60}, {100, 60}, {100, -40}}, color = {0, 0, 127}));
  connect(mechanicalBrakeTorqueBusSignal.y, brakesControlBus.mechanicalBrakeTorqueRequest) annotation(
    Line(points = {{326.5, -10}, {350, -10}, {350, -40}}, color = {0, 0, 127}));

  connect(motorTorqueRequest.y, vcu.cmd_torque_motor) annotation(
    Line(points = {{44.75, 130}, {45, 130}, {45, 50}}, color = {0, 0, 127}));
  connect(regenLimitRequest.y, vcu.cmd_regen_limit) annotation(
    Line(points = {{-78.5, 31.25}, {-60, 31.25}}, color = {0, 0, 127}));
  connect(inverterEnableBusTap, vcu.cmd_inverter_enable) annotation(
    Line(points = {{-180, 42.5}, {-60, 42.5}}, color = {255, 0, 255}));
  connect(motorSpeedBusTap, vcu.sens_motor_speed) annotation(
    Line(points = {{-180, 20}, {-60, 20}}, color = {0, 0, 127}));

  annotation(
    Documentation(info = "<html>
<p>
Model <code>VCU</code> is the public controller adapter exposed inside the
VehicleInterfaces controller domain.
</p>
<p>
The adapter's wiring boundary is the inherited <code>controlBus</code>. It
subscribes to driver commands and motor speed through the typed subsystem
buses, then publishes its
power request, torque limits, VCU status, drive-torque request, and mechanical
brake request back onto the shared bus namespace. Driver-bus pedal fields remain
driver-environment intent; the VCU's normalized pedal outputs are diagnostics
for the controller-generated actuator requests.
</p>
<p>
The VCU maps normalized accelerator intent to available drive torque and normalized brake intent to the configured brake torque capacity. Optional regeneration consumes the configured fraction of brake demand up to its motor-side limit while the inverter is enabled; mechanical brakes supply the remainder when enabled. Disabling the inverter removes the regenerative allocation immediately, restoring the full requested friction braking. This is command allocation, not feedback of battery or motor power availability. It does not generate steering maneuvers or regulate vehicle speed. The same intent/limit path is used by native drivers and scalar-command FMUs.
</p>
</html>"));
  annotation(Diagram(coordinateSystem(extent = {{-260, -100}, {380, 200}}, preserveAspectRatio = true)));
end VCU;
