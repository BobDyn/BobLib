within BobLib.Chassis.Suspension.Tires;
package MF52

  extends Modelica.Icons.FunctionsPackage;

  annotation(
    Documentation(info = "<html>
<p>
Package <code>BobLib.Chassis.Suspension.Tires.MF52</code> contains Magic Formula 5.2 tire calculations.
</p>
<p>
The package separates coefficient records, slip-state models, pure-slip functions, combined-slip functions, and the aggregate tire evaluator.
</p>
</html>"));
  annotation(Icon(graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, lineThickness = 0.5, fillPattern = FillPattern.None)}));
end MF52;
