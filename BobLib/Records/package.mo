within BobLib;
package Records

  "Vehicle parameter records and simulation records"
  extends Modelica.Icons.RecordsPackage;

  annotation(
    preferredView = "info",
    Documentation(info = "<html>
<p>
Vehicle parameter records, visual records, and experiment record definitions.
The icon keeps the standard package shape with the amber color language from
MSL record packages.
</p>
</html>"));
  annotation(Icon(graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, lineThickness = 0.5, fillPattern = FillPattern.None)}));
end Records;
