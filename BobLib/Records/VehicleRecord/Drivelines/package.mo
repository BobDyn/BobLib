within BobLib.Records.VehicleRecord;
package Drivelines

  extends Modelica.Icons.RecordsPackage;

  annotation(
    Documentation(info = "<html>
<p>
Package <code>BobLib.Records.VehicleRecord.Drivelines</code>
contains driveline subsystem parameter records.
</p>
<p>
Records in this package mirror the public driveline models used by
vehicle-level experiments.
</p>
</html>"));
  annotation(Icon(graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, lineThickness = 0.5, fillPattern = FillPattern.None)}));
end Drivelines;
