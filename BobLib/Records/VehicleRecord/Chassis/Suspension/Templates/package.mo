within BobLib.Records.VehicleRecord.Chassis.Suspension;
package Templates

  extends Modelica.Icons.RecordsPackage;

  annotation(
    Documentation(info = "<html>
<p>
Package <code>BobLib.Records.VehicleRecord.Chassis.Suspension.Templates</code>
contains reusable suspension physics records.
</p>
<p>
These records parameterize BobLib-specific double-wishbone linkages, steering
racks, stabilizer bars, tire templates, and reusable mass properties below the
VehicleInterfaces-facing axle contract.
</p>
</html>"));
  annotation(Icon(graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, lineThickness = 0.5, fillPattern = FillPattern.None)}));
end Templates;
