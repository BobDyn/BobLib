within BobLib.Records.VehicleRecord.Chassis.Suspension.Templates;
package DoubleWishbone

  extends Modelica.Icons.RecordsPackage;

  annotation(
    Documentation(info = "<html>
<p>
Package <code>BobLib.Records.VehicleRecord.Chassis.Suspension.Templates.DoubleWishbone</code>
contains double-wishbone geometry records.
</p>
<p>
Records here define inboard pickups, outboard points, tie-rod points, and wheel
center geometry consumed by the double-wishbone suspension templates.
</p>
</html>"));
  annotation(Icon(graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, lineThickness = 0.5, fillPattern = FillPattern.None)}));
end DoubleWishbone;
