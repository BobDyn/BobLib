within BobLib.Records.VehicleRecord.Chassis.Suspension.Templates;
package Stabar

  extends Modelica.Icons.RecordsPackage;

  annotation(
    Documentation(info = "<html>
<p>
Package <code>BobLib.Records.VehicleRecord.Chassis.Suspension.Templates.Stabar</code>
contains stabilizer-bar parameter records.
</p>
<p>
Records here describe stabilizer-bar pickup geometry and torsional rate used by
the suspension template models.
</p>
</html>"));
  annotation(Icon(graphics = {Rectangle(extent = {{-100, 100}, {100, -100}}, lineColor = {0, 0, 0}, lineThickness = 0.5, fillPattern = FillPattern.None)}));
end Stabar;
